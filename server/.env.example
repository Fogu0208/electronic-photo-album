# 复制本文件为 .env，再按你本机的实际情况修改
# .env 已被 .gitignore 排除，不会被提交到仓库

# 服务监听
HOST=127.0.0.1
PORT=8081

# 数据库连接（注意端口：源码默认是 3308，多数本机 MySQL 是 3306）
DB_URL=mysql+pymysql://root:你的MySQL密码@127.0.0.1:3306/db_photo_album?charset=utf8mb4

# 图片上传目录（相对 server 目录，程序启动时会自动创建）
UPLOAD_PATH=./uploads31

# JWT 密钥（建议改成自己的随机字符串）
JWT_SECRET=change-me-to-a-random-string
JWT_EXPIRE_MS=86400000
